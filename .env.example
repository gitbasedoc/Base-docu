# ====================================
# CONFIGURATION KB SUPPORT BASEDOC
# ====================================

# DATABASE
# --------
# URL de connexion PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://kb_user:CHANGE_ME@localhost/kb_basedoc

# FLASK
# -----
# Clé secrète Flask (IMPORTANT: générer une clé aléatoire unique)
# Générer avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_KEY

# Environnement (development, production, testing)
FLASK_ENV=production

# Application
FLASK_APP=run.py

# CLAUDE AI
# ---------
# Clé API Anthropic (commence par sk-ant-)
# Obtenir sur: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-CHANGE_ME

# Modèle Claude à utiliser
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Tokens maximum par requête
CLAUDE_MAX_TOKENS=4096

# Timeout en secondes
CLAUDE_TIMEOUT=60

# APPLICATION
# -----------
# Nom de l'application
APP_NAME=KB Support Basedoc

# Nom de l'entreprise
COMPANY_NAME=Support IT - Gagneraud

# Dossier de stockage des fichiers uploadés
UPLOAD_FOLDER=/var/www/kb_basedoc/storage

# LOGGING
# -------
# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Fichier de log
LOG_FILE=/var/log/kb_basedoc/app.log

# CACHE & RATE LIMITING (optionnel)
# ----------------------------------
# Type de cache (simple, redis, memcached)
CACHE_TYPE=simple

# URL de stockage pour rate limiting (memory://, redis://...)
RATELIMIT_STORAGE_URL=memory://

# ====================================
# EXEMPLE DE CONFIGURATION COMPLÈTE
# ====================================

