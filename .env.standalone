# Configuration standalone pour KB Support Basedoc
# Application mono-utilisateur sans authentification

# Mode de fonctionnement
FLASK_ENV=standalone

# Secret key (générez une clé aléatoire unique pour votre installation)
SECRET_KEY=standalone-kb-basedoc-change-me

# Application
APP_NAME=KB Support Basedoc
COMPANY_NAME=Support IT

# Claude API (optionnel - si vous voulez la révision IA des scripts)
# Décommentez et ajoutez votre clé API si vous avez un compte Claude
# CLAUDE_API_KEY=votre_cle_api_ici
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Cache
CACHE_TYPE=simple

# Logs
LOG_LEVEL=INFO
